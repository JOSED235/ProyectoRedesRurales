# /etc/nginx/sites-available/hub — copia real del hub (respaldo 2026-11-17, Fase 2.3)
# + bloque /video/ de la CDN de video (Fase 2.4, 2026-11-20)
# HTTP: solo entrega el certificado de la CA y redirige lo demás a HTTPS
server {
    listen 80 default_server;
    server_name _;
    location = /ca-hub.crt { root /srv/cdn/www; }
    # Guía para instalar la CA: por HTTP porque sin la CA el HTTPS muestra advertencia
    location = /certificado.html { root /srv/cdn/www; }
    location / { return 301 https://portal.hub.lan$request_uri; }
}

# Portal y CDN
server {
    listen 443 ssl http2 default_server;
    server_name portal.hub.lan cdn.hub.lan;
    ssl_certificate     /etc/hub/pki/hub.crt;
    ssl_certificate_key /etc/hub/pki/hub.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    root  /srv/cdn/www;
    index index.html;
    charset utf-8;
    location /sitios/ { autoindex on; }
    location /pdf/    { autoindex on; }
    # CDN de video (Fase 2.4): MP4 720p con faststart en el disco USB.
    # ^~ gana sobre la regex de estáticos de abajo (si no, las miniaturas .jpg daban 404).
    # Nginx responde 206 Partial Content a las peticiones Range: se puede adelantar el video.
    location ^~ /video/ {
        alias /srv/cdn/video/;
        autoindex on;
        expires 7d;
    }
    location ~* \.(css|js|png|jpe?g|gif|svg|webp|woff2?|pdf)$ { expires 30d; }
}

# Wikipedia sin conexión (Kiwix)
server {
    listen 443 ssl http2;
    server_name wiki.hub.lan;
    ssl_certificate     /etc/hub/pki/hub.crt;
    ssl_certificate_key /etc/hub/pki/hub.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    location / { proxy_pass http://127.0.0.1:8080; proxy_set_header Host $host; }
}
